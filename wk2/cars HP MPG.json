{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A scatterplot showing horsepower and miles per gallons for various cars.",
  "data": {"url": "data/cars.json"},
  "title": {"text": "Cars Horsepower & Miles per Gallons", "font": "muli"},
  "mark": {"type": "point", "color": "rgba(128,0,0,.8)"},
  "encoding": {
    "x": {
      "field": "Horsepower",
      "type": "quantitative",
      "axis": {"title": "Horse powers", "titleFont": "muli"}
    },
    "y": {
      "field": "Miles_per_Gallon",
      "type": "quantitative",
      "axis": {"title": "MPG", "titleFont": "muli"}
    }
  },
  "config": {}
}